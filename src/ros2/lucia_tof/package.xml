  <version>0.1.0</version>
  <description>Publishes the Pico 2 VL53L5CX ToF sensor frames for LUCIA.</description>
  <maintainer email="noeltem98@gmail.com">LUCIA Team</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
